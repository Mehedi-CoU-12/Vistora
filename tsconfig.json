{
    "extends": "@react-native/typescript-config",
    "compilerOptions": {
        "customConditions": [
            "react-native-legacy-deep-imports",
            "react-native"
        ],
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noFallthroughCasesInSwitch": true,
        "noImplicitOverride": true,
        "verbatimModuleSyntax": false
    },
    "include": [
        "src/**/*.ts",
        "src/**/*.tsx",
        "App.tsx",
        "env.d.ts"
    ],
    "exclude": [
        "node_modules",
        "android"
    ]
}