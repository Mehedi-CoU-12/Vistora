<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 13 (API 33) and up additionally support themed icons: when the user turns
  on "Themed icons", the launcher recolours the monochrome layer to match their
  wallpaper instead of drawing the coloured foreground. Everything else falls back
  to the v26 definition above.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome" />
</adaptive-icon>
