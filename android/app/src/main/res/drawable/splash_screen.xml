<?xml version="1.0" encoding="utf-8"?>
<!--
  The launch splash for API 24 to 30, where the platform has no splash screen of
  its own and this window background is the only thing on screen from tap until
  React paints.

  Because it is the only surface there, it can show the whole lock-up: mark, name
  and motto together, at a comfortable size. That freedom is exactly what API 31+
  does not have, which is why the newer path is configured separately in
  res/values-v31/styles.xml and does NOT use this drawable.

  The bitmap is not scaled: splash_lockup.png is generated per density bucket at a
  fixed dp width, so gravity="center" is all the positioning needed.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/background" />
    <item>
        <bitmap
            android:src="@drawable/splash_lockup"
            android:gravity="center" />
    </item>
</layer-list>
