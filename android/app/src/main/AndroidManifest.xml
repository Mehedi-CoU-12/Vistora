<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Media3/ExoPlayer needs this to keep playback alive while the screen is on. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!--
      ANDROID TV DECLARATIONS
      =======================
      android.software.leanback
        Marks this as an Android TV (Leanback) app. Google Play uses it to list the
        app in the TV section. We set required="false" on purpose so the same APK
        still installs on a regular phone/tablet emulator during development. For a
        TV-only Play Store release, flip this to "true" and drop the plain LAUNCHER
        category from the activity below.

      android.hardware.touchscreen required="false"
        Mandatory for TV. TVs have no touchscreen, so without this Play will refuse
        to list the app on TV devices.

      android.hardware.microphone / android.hardware.camera required="false"
        Many TV devices lack these. Declaring them non-required avoids being filtered
        out of the TV catalogue.
    -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.microphone"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <application
        android:name=".MainApplication"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:banner="@drawable/banner"
        android:allowBackup="false"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="${usesCleartextTraffic}"
        android:supportsRtl="true">

        <!--
          NOTE: there is deliberately no android:screenOrientation below.

          One APK serves two devices that want opposite answers: a TV is
          landscape and nothing else, a phone is portrait until its owner turns
          it. A manifest attribute cannot express both. It is a single static
          value, with no resource qualifier and no way to vary by device, so
          MainActivity sets `requestedOrientation` at startup, from the same
          television check React Native's own `Platform.isTV` uses. See
          MainActivity.kt.

          android:configChanges is what makes rotating cheap. It lists
          orientation, screenSize, screenLayout and smallestScreenSize, so
          turning the phone reconfigures the activity in place instead of
          recreating it: React Native turns the change into a dimensions event,
          the tree re-renders with new metrics, and navigation state, scroll
          offsets and playback all survive the turn.

          android:supportsPictureInPicture is what makes the player's "Pop out"
          control possible, and note that without it the request fails SILENTLY:
          react-native-video reads the flag back off our own ActivityInfo and
          returns early, so the button would simply do nothing. The player only
          offers it on a touch device.
        -->
        <activity
            android:name=".MainActivity"
            android:label="@string/app_name"
            android:banner="@drawable/banner"
            android:theme="@style/SplashTheme"
            android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:launchMode="singleTask"
            android:supportsPictureInPicture="true"
            android:windowSoftInputMode="adjustResize"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <!-- Required for the app to appear on the Android TV home screen. -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
                <!-- Keep this so the app is also launchable on a phone/tablet emulator
                     while developing. Remove for a TV-only release. -->
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
