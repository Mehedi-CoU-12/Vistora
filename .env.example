# Copy this file to `.env` and fill in your own project values:
#   cp .env.example .env
#
# Find both values in the Supabase dashboard under
#   Project Settings -> API Keys
#
# SUPABASE_ANON_KEY takes the PUBLIC key. Supabase issues two formats and both
# work here:
#   * the newer `sb_publishable_...` key  (shown as "publishable" / "anon public")
#   * the legacy `eyJ...` anon JWT
# Either is safe to ship in a client app: it grants only what your Row Level
# Security policies allow.
#
# NEVER put a secret key in this file -- not `sb_secret_...`, not the
# service_role JWT, not the database password. Those bypass RLS entirely, and
# everything in `.env` is inlined into the JavaScript bundle that ships on the
# device, where anyone can read it.
#
# After editing this file you must restart Metro with a cleared cache, because
# it is read at BUILD time, not at runtime:
#   npm start -- --reset-cache
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-publishable-or-anon-key
