# Copy this file to `.env` and fill in your own project values:
#   cp .env.example .env
#
# Find both values in the Supabase dashboard under
#   Project Settings -> API
#
# SUPABASE_ANON_KEY is a PUBLIC key. It is safe to ship in a client app: it only
# grants whatever your Row Level Security policies allow.
#
# NEVER put SUPABASE_SERVICE_ROLE_KEY (or the database password) in this file.
# That key bypasses RLS entirely, and everything in `.env` gets inlined into the
# JavaScript bundle that ships on the device, where anyone can read it.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
